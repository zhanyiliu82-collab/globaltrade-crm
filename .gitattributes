# 统一换行符处理，避免 Windows/macOS/Linux 协作时产生虚假 diff
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本在 Linux 服务器上必须为 LF，并保持可执行
*.sh text eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary
